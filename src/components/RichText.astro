---
// Running copy with links in it, as Portable Text.
//
// This used to take a hand-written list of segments; it takes blocks from the
// content lake now, but it draws exactly what it drew before, because the marks
// the schema allows are the same three things the design has ever needed:
//
//   a link annotation      -> a link, in the site's dress
//   a newsletter annotation -> the button that opens the sign-up card
//   the `small` decorator  -> an aside, set half size
//
// Every link wears the same dress whatever it does, because to a reader they
// are all the same offer: the site's marker plus a rule, so the link reads as
// one at rest too — the marker alone is a hover state, and there is no hover on
// a touch screen.
import { localize } from "../lib/i18n.js";

interface Props {
    /** Portable Text blocks. */
    value?: any[] | null;
    /** Wraps each block. Pass the type the caller sets; defaults to a <p>. */
    class?: string;
    locale?: string;
    /** Render a single block's spans with no wrapper, for copy already in a <p>. */
    inline?: boolean;
}

const { value, class: cls = "", locale = "en", inline = false } = Astro.props;
const blocks = (value ?? []).filter((b) => b?._type === "block");

const dress = "hl-link underline decoration-1 underline-offset-2";

/** The mark definitions a span's `marks` can point at, by key. */
const defs = (block: any) =>
    Object.fromEntries((block.markDefs ?? []).map((d: any) => [d._key, d]));
---

{
    blocks.map((block) => {
        const md = defs(block);
        const spans = (block.children ?? []).map((span: any) => {
            const marks = span.marks ?? [];
            const link = marks.map((m: string) => md[m]).find(Boolean);
            const small = marks.includes("small");
            const em = marks.includes("em");
            const strong = marks.includes("strong");

            // The plain cases first, so the common span costs nothing.
            let text: any = span.text;
            if (small) text = <span class="text-[0.5em]">{text}</span>;
            if (strong) text = <strong>{text}</strong>;
            // Review Condensed has no italic cut, so an `em` is a synthesised
            // slant on desktop only — the same compromise the About page made
            // when this was hard-coded.
            if (em) text = <em class="not-italic md:italic">{text}</em>;

            if (link?._type === "newsletter") {
                return (
                    <button
                        type="button"
                        data-newsletter-open
                        class={`${dress} cursor-pointer text-left`}
                    >
                        <span class="hl-mark" aria-hidden="true" />
                        <span class="hl-label">{text}</span>
                    </button>
                );
            }

            if (link?._type === "link") {
                // A mailto hands off to a mail client and an in-site link stays
                // in the tab you are reading; only somewhere else on the web
                // gets a new one. In-site links are localized, so a French page
                // never sends you back into the English tree.
                const external = /^https?:/.test(link.href ?? "");
                return (
                    <a
                        href={localize(link.href, locale)}
                        target={external ? "_blank" : undefined}
                        rel={external ? "noopener" : undefined}
                        class={dress}
                    >
                        <span class="hl-mark" aria-hidden="true" />
                        <span class="hl-label">{text}</span>
                    </a>
                );
            }

            return text;
        });

        return inline ? spans : <p class={cls}>{spans}</p>;
    })
}
