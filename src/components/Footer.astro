---
// Shared contact block — appears at the foot of every page, and is the whole
// of /contact. Figma: photo 802/1603 wide, the text column inset 30px (1.87cqw)
// from the split with a 20px (1.247cqw) rhythm down its stack.
//
// It takes the 1603/1080 block height the homepage sections run at (1080/1603 =
// 67.374cqw of the content column), so it sits in the same rhythm rather than on
// the viewport's — as an appended footer and as the page itself (/contact)
// alike. `full` only changes whether it draws the rule above it: as the page,
// the band over it already has one.
import Img from "./Img.astro";
import { social } from "../data/social.js";
import { ACTION, TRAP } from "../data/newsletter.js";
import Arrow from "./Arrow.astro";

interface Props {
    /** /contact renders it as the page itself — no sibling section above it. */
    full?: boolean;
}
const { full = false } = Astro.props;

const eyebrow = "w-fit text-[clamp(14px,1.372cqw,22px)] leading-[1.1] tracking-[-0.02em]";
// 72/1603 = 4.49cqw. The 34px floor is for the stacked layout, where this
// column is the full width of the page; once the block splits in two at md the
// column is half as wide and that floor overran it — "contact@lehub.ca" wants
// 283px at 34px and the column is 254px at the md breakpoint — so above md the
// type is left to the ratio, which is measured to fit the half column.
const big =
    "block w-fit font-display font-extrabold uppercase leading-[0.82] text-black/90 text-[clamp(34px,4.49cqw,72px)] md:text-[clamp(20px,4.49cqw,72px)]";
// The links in this block take the pink marker instead of turning pink; `big`
// itself stays plain because the newsletter input wears it too.
const bigLink = `${big} hl-link`;
---

<footer
    {/* `full` means the footer IS the page, under a band of its own — and the
        band draws the rule between them, the way it does everywhere else. */}
    class:list={[
        // `grow` takes up whatever the page has left over when it is shorter
        // than the window — the block keeps its own height everywhere else.
        //
        // `overflow-hidden` is for the land-acknowledgement card: it rests at
        // `translate: 0 6%` while closed, and an absolutely positioned box still
        // grows the document's scrollable area even at opacity 0 / visibility
        // hidden — which left ~24px of dead paper under the last block on every
        // page. Clipping it here means the card steps up from behind the
        // footer's own bottom edge instead of out of the page's slack.
        "relative flex w-full grow flex-col overflow-hidden bg-paper md:min-h-[67.374cqw]",
        !full && "border-t",
    ]}
    data-footer
>
    <div class="flex grow flex-col md:flex-row">
        <!-- photo -->
        <div class="h-[420px] w-full shrink-0 md:h-full md:w-1/2 md:border-r">
            <Img name="footer.png" alt="" position="object-center" />
        </div>

        <!-- content -->
        <div
            class="flex w-full flex-col justify-between px-4 pt-6 md:w-1/2 md:px-[1.87cqw] md:pt-8"
        >
            <div class="flex flex-col gap-[max(1.247cqw,14px)]">
                <div class="flex flex-col gap-[max(1.247cqw,14px)]">
                    <p class={eyebrow}>
                        For general inquiries, training requests, or questions about our programs,
                        reach us at:
                    </p>
                    <a href="mailto:contact@lehub.ca" class={bigLink}>
                        <span class="hl-mark" aria-hidden="true"></span>
                        <span class="hl-label">contact@lehub.ca</span>
                    </a>
                </div>

                <div class="flex flex-col gap-[max(1.247cqw,14px)]">
                    <span class={eyebrow}>Follow us on social media:</span>
                    <div class="flex flex-col">
                        <a
                            href={social.instagram}
                            target="_blank"
                            rel="noopener"
                            class={bigLink}
                        >
                            <span class="hl-mark" aria-hidden="true"></span>
                            <span class="hl-label">Instagram</span>
                        </a>
                        <a
                            href={social.facebook}
                            target="_blank"
                            rel="noopener"
                            class={bigLink}
                        >
                            <span class="hl-mark" aria-hidden="true"></span>
                            <span class="hl-label">Facebook</span>
                        </a>
                    </div>
                </div>

                {
                    /* The form is hosted off-site (CryptPad), so this is the one
                    link in the block that leaves for somewhere that is not a
                    social account or the inbox. */
                }
                <div class="flex flex-col gap-[max(1.247cqw,14px)]">
                    <p class={eyebrow}>
                        Tell us what you learned, what changed in your organizing, and where we can
                        do better — with your name or anonymously. Your reflections keep us
                        accountable and show funders what this work makes possible.
                    </p>
                    <a
                        href="https://cryptpad.fr/form/#/3/form/view/65931ccc0fee9528dc5bce72b3bdf6f5/"
                        target="_blank"
                        rel="noopener"
                        class={bigLink}
                    >
                        <span class="hl-mark" aria-hidden="true"></span>
                        <span class="hl-label">Share a testimonial</span>
                    </a>
                </div>

                <div class="flex flex-col gap-[max(1.247cqw,14px)]">
                    <label class={eyebrow} for="nl-footer">Sign up for our newsletter:</label>
                    {/* This one is the real thing, not a trigger: the field is
                        already the size of the card the overlay would open, so
                        sending it somewhere to be retyped would be a step for
                        nothing. It posts straight to the list, same as the
                        overlay does. */}
                    <form
                        action={ACTION}
                        method="post"
                        target="_blank"
                        class="flex w-full items-end justify-between gap-4"
                    >
                        <input
                            id="nl-footer"
                            type="email"
                            name="EMAIL"
                            required
                            autocomplete="email"
                            placeholder="EMAIL"
                            class={`${big} min-w-0 flex-1 bg-transparent outline-none placeholder:text-black/90 focus:placeholder:text-black/35`}
                        />
                        {/* Off-screen rather than hidden: a bot fills what it
                            can read, and `display: none` is the one thing they
                            know to skip. */}
                        <div class="absolute left-[-5000px]" aria-hidden="true">
                            <input type="text" name={TRAP} tabindex="-1" value="" />
                        </div>
                        <button
                            type="submit"
                            aria-label="Subscribe"
                            class="grid aspect-square shrink-0 cursor-pointer place-items-center bg-pink text-black/90 text-[34px] leading-none md:w-[4.06cqw] md:text-[clamp(20px,2.86cqw,46px)]"
                        >
                            <Arrow />
                        </button>
                    </form>
                    <span class="block h-px w-full bg-black"></span>
                </div>
            </div>

            <div
                class="mt-10 flex flex-col gap-2 text-[clamp(12px,1.123cqw,18px)] leading-none tracking-[-0.02em] md:mt-0 md:flex-row md:items-end md:justify-between pb-8"
            >
                <p id="land-ack-line">
                    Le Hub was founded on the territories of The Kanien’kehá:ka.
                </p>
                {
                    /* A disclosure, not a link: the full acknowledgement is on the
                    page already and this uncovers it, the same way "Read full
                    testimonial" does. */
                }
                <button
                    type="button"
                    data-land-open
                    aria-expanded="false"
                    aria-controls="land-ack"
                    class="hl-link shrink-0 cursor-pointer text-left"
                >
                    <span class="hl-mark" aria-hidden="true"></span>
                    <span class="hl-label">Read more →</span>
                </button>
            </div>
        </div>
    </div>

    {
        /* The full acknowledgement, stamped over the column it expands — bottom
        edge to bottom edge with the line that opens it, so it reads as that
        line growing rather than as a card arriving from somewhere else. It is
        the one block on the site printed in the rose the About bands leave
        unused. Anchored to the bottom rather than centred because the trigger
        is on the footer's last line: wherever the footer sits in the window
        when you click, the card opens where you are already looking.

        It only narrows to the column at lg. Between md and there the column is
        half of a small screen — 274px at the breakpoint — and this much copy
        set in it is a gutter, so below lg the card spans the footer instead.

        Absolute, not fixed: `main` is a container (`@container`), which makes
        it the containing block for fixed descendants too, so a fixed card
        would centre itself on the whole document, not the screen. It caps at
        the screen's height instead and scrolls inside. */
    }
    <div
        id="land-ack"
        data-land-panel
        role="dialog"
        aria-modal="false"
        aria-labelledby="land-ack-title"
        class="stamp-panel absolute inset-x-0 bottom-0 z-40 flex max-h-[86svh] flex-col gap-3 border border-b-2 bg-band-rose p-4 text-black/90 md:max-h-[92%] md:gap-[1.247cqw] md:p-[1.87cqw] lg:left-1/2"
    >
        <div
            class={`flex shrink-0 items-baseline justify-between gap-4 border-b pb-[0.6em] ${eyebrow} w-full`}
        >
            <span id="land-ack-title">Land acknowledgement</span>
            <button type="button" data-land-close class="shrink-0 cursor-pointer hover:text-pink">
                close ×
            </button>
        </div>
        {
            /* Two long paragraphs against a card that can only be as tall as the
            screen, so the body scrolls and the heading rule holds the top. */
        }
        <div class="min-h-0 flex-1 overflow-y-auto">
            <div
                class="flex flex-col gap-[0.9em] text-[clamp(13px,1.372cqw,22px)] leading-[1.2] tracking-[-0.01em]"
            >
                <p>
                    The Organizing Hub / Le Hub de Mobilisation was founded on the territories of
                    The Kanien’kehá:ka, who are the keepers of the Eastern Door of the Haudenosaunee
                    Confederacy. The island called “Montreal” is known as Tiotià:ke in Kanien’kehá,
                    and has long been a meeting place for many Indigenous nations. Le Hub team is
                    based across Turtle Island, including Tiotià:ke, unceded Algonquin territory in
                    rural Ontario, and Tkaronto.
                </p>
                <p>
                    Our understandings of organizing have been shaped by the leadership of multiple
                    active Indigenous struggles, including: Aamjiwnaang First Nation’s and Grassy
                    Narrows First Nation’s fights against environmental racism in Treaty 29 and
                    Treaty 3 territory; Neskantaga First Nation’s ongoing fight against the
                    so-called Ring of Fire; the massive #ShutDownCanada movement of 2020 led by
                    Wet’suwet’en land defenders; the leadership of Nehirowisiw, Innu, Abenaki and
                    Anishinaabe land defenders in the MAMO Alliance and the km 134 blockades against
                    commercial logging in Quebec; and global Indigenous struggles against Canadian
                    mining across Latin America, Africa, and the Global South.
                </p>
            </div>
        </div>
    </div>
</footer>
