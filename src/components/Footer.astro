---
// Shared contact block — appears at the foot of every page, and is the whole
// of /contact. Figma: photo 802/1603 wide, the text column inset 30px (1.87cqw)
// from the split; the stack's vertical rhythm is the three-step scale below.
//
// It takes the 1603/1080 block height the homepage sections run at (1080/1603 =
// 67.374cqw of the content column), so it sits in the same rhythm rather than on
// the viewport's — as an appended footer and as the page itself (/contact)
// alike. `full` only changes whether it draws the rule above it: as the page,
// the band over it already has one.
import Img from "./Img.astro";
import RichText from "./RichText.astro";
import Arrow from "./Arrow.astro";
import { Image } from "astro:assets";

import scfLogo from "../assets/images/scf_logo.png";

interface Props {
    settings: any;
    ui: any;
    locale: string;
    /** /contact renders it as the page itself — no sibling section above it. */
    full?: boolean;
}
const { settings, ui, locale, full = false } = Astro.props;

const eyebrow = "w-fit text-[clamp(14px,1.372cqw,22px)] leading-[1.1] ";
// 72/1603 = 4.49cqw. The 34px floor is for the stacked layout, where this
// column is the full width of the page; once the block splits in two at md the
// column is half as wide and that floor overran it — "contact@lehub.ca" wants
// 283px at 34px and the column is 254px at the md breakpoint — so above md the
// type is left to the ratio, which is measured to fit the half column.
const big =
    "block w-fit font-display font-extrabold uppercase leading-[0.82] text-black/90 text-[clamp(34px,4.49cqw,72px)] md:text-[clamp(20px,4.49cqw,72px)]";
// The links in this block take the pink marker instead of turning pink; `big`
// itself stays plain because the newsletter input wears it too.
const bigLink = `${big} hl-link`;

// Three steps, not one. The block was set on a flat 1.247cqw everywhere, which
// meant a label and the line it labels were pushed as far apart as two
// unrelated items — so the stack read as eight loose things rather than four
// pairs in two groups. Each step is roughly 1.5x the one under it:
//
//   PAIR  a label and the thing it labels — they are one unit
//   ITEM  between those units inside a group
//   GROUP across the rule, and the column's own top and bottom padding
//
// PAIR is the smallest because it has the most help: `big` is set at
// leading-[0.82], so its box crops close to the caps and the ink sits nearer
// the gap than the metrics suggest, while the eyebrow's 1.1 leaves slack of
// its own above. Measured 20px looks like 26 between those two.
//
// Each constant is a whole class rather than the bare length: Tailwind v4
// finds candidates by scanning this file for literal strings, so a class
// assembled out of an interpolated length is one it never sees and never
// generates. GROUP's length is spelled out in full at the two places it is used
// as padding rather than gap, for the same reason.
const PAIR = "gap-[max(0.85cqw,12px)]";
const ITEM = "gap-[max(1.87cqw,22px)]";
const GROUP = "gap-[max(2.494cqw,28px)]";
---

<footer
    {/* `full` means the footer IS the page, under a band of its own — and the
        band draws the rule between them, the way it does everywhere else. */}
    class:list={[
        // `grow` takes up whatever the page has left over when it is shorter
        // than the window — the block keeps its own height everywhere else.
        //
        // `overflow-hidden` is for the land-acknowledgement card: it rests at
        // `translate: 0 6%` while closed, and an absolutely positioned box still
        // grows the document's scrollable area even at opacity 0 / visibility
        // hidden — which left ~24px of dead paper under the last block on every
        // page. Clipping it here means the card steps up from behind the
        // footer's own bottom edge instead of out of the page's slack.
        "relative flex w-full grow flex-col overflow-hidden bg-paper md:min-h-[67.374cqw]",
        !full && "border-t",
    ]}
    data-footer
>
    <div class="flex grow flex-col md:flex-row">
        <!-- photo -->
        {
            /* `md:h-auto`, not `h-full`: this is a flex item in a row whose own
            height is set by the column beside it, so a percentage height has
            nothing definite to resolve against and computes to auto — which
            left a strip of paper under the photo. At auto, the default
            `align-items: stretch` sizes it to the row, and the image's own
            `h-full` then has a definite box to fill. */
        }
        <div class="h-[420px] w-full shrink-0 md:h-auto md:w-1/2 md:border-r">
            <Img image={settings?.footerImage} alt="" label="footer.png" />
        </div>

        <!-- content -->
        <div
            class="flex w-full flex-col justify-between px-4 pt-[max(2.494cqw,28px)] md:w-1/2 md:px-[1.87cqw]"
        >
            {
                /* Two groups: the ways to reach us, then the two things we ask
                of you. The rule between them is the one the site draws
                everywhere else — `border-b` on the block above the seam — and
                the padding under it matches the stack's own gap, so the stroke
                sits midway between the blocks rather than crowding the one it
                belongs to. */
            }
            <div class={`flex flex-col ${GROUP}`}>
                <div class={`flex flex-col ${ITEM}`}>
                    <div class={`flex flex-col ${PAIR}`}>
                        <p class={eyebrow}>{settings?.contactEyebrow}</p>
                        <a href={`mailto:${settings?.contactEmail}`} class={bigLink}>
                            <span class="hl-mark" aria-hidden="true"></span>
                            <span class="hl-label">{settings?.contactEmail}</span>
                        </a>
                    </div>

                    <div class={`flex flex-col ${PAIR}`}>
                        <span class={eyebrow}>{settings?.socialEyebrow}</span>
                        <div class="flex flex-col">
                            <a
                                href={settings?.instagram}
                                target="_blank"
                                rel="noopener"
                                class={bigLink}
                            >
                                <span class="hl-mark" aria-hidden="true"></span>
                                <span class="hl-label">Instagram</span>
                            </a>
                            <a
                                href={settings?.facebook}
                                target="_blank"
                                rel="noopener"
                                class={bigLink}
                            >
                                <span class="hl-mark" aria-hidden="true"></span>
                                <span class="hl-label">Facebook</span>
                            </a>
                        </div>
                    </div>
                </div>
                <div class={`flex flex-col -mt-2 ${ITEM}`}>
                    {
                        /* The form is hosted off-site (CryptPad), so this is the
                        one link in the block that leaves for somewhere that is
                        not a social account or the inbox. */
                    }
                    <div class={`flex flex-col ${PAIR}`}>
                        <p class={eyebrow}>{settings?.testimonialEyebrow}</p>
                        <a
                            href={settings?.testimonialUrl}
                            target="_blank"
                            rel="noopener"
                            class={bigLink}
                        >
                            <span class="hl-mark" aria-hidden="true"></span>
                            <span class="hl-label">{settings?.testimonialLinkLabel}</span>
                        </a>
                    </div>
                </div>
                <div class={`flex flex-col ${PAIR}`}>
                    <label class={eyebrow} for="nl-footer">{settings?.newsletterFooterLabel}</label>
                    {
                        /* This one is the real thing, not a trigger: the field
                        is already the size of the card the overlay would
                        open, so sending it somewhere to be retyped would be
                        a step for nothing. It posts straight to the list,
                        same as the overlay does. */
                    }
                    {
                        /* The rule is the input's underline, not the next thing
                        down — it rides with the field on the descender's
                        slack rather than on the stack's gap, which had it
                        floating a clear 20px under the type it belongs to. */
                    }
                    <div class="flex flex-col gap-[0.12em]">
                        <form
                            action={settings?.newsletterAction}
                            method="post"
                            target="_blank"
                            class="flex w-full items-end justify-between gap-4"
                        >
                            <input
                                id="nl-footer"
                                type="email"
                                name="EMAIL"
                                required
                                autocomplete="email"
                                placeholder={ui?.emailPlaceholder?.toUpperCase()}
                                class={`${big} min-w-0 flex-1 border-0 -mt-2 bg-transparent p-0 outline-none placeholder:text-black/90 focus:placeholder:text-black/35`}
                            />
                            {
                                /* Off-screen rather than hidden: a bot fills what
                                it can read, and `display: none` is the one thing
                                they know to skip. */
                            }
                            <div class="absolute left-[-5000px]" aria-hidden="true">
                                <input
                                    type="text"
                                    name={settings?.newsletterTrap}
                                    tabindex="-1"
                                    value=""
                                />
                            </div>
                            {
                                /* The square is the cap height of the word
                                beside it, so it reads as the same size as
                                EMAIL rather than as a block that overshoots
                                it. This face caps at exactly 0.75em, so the
                                width mirrors `big`'s own clamp scaled by
                                0.75 — including its md step, where the
                                floor drops because the column halves — and
                                `items-end` on the form sets it on the
                                baseline. The arrow is 70% of the square,
                                the proportion it had before. */
                            }
                            <button
                                type="submit"
                                aria-label={ui?.subscribe}
                                class="grid aspect-square shrink-0 mb-2 cursor-pointer place-items-center bg-pink text-black/90 leading-none w-[clamp(25.5px,3.3675cqw,54px)] text-[clamp(18px,2.357cqw,38px)] md:w-[clamp(15px,3.3675cqw,54px)] md:text-[clamp(10.5px,2.357cqw,38px)]"
                            >
                                <Arrow />
                            </button>
                        </form>
                        <span class="block h-px w-full bg-black"></span>
                    </div>
                </div>
            </div>

            {
                /* The margin is a floor, not a gap. `justify-between` pins this row to
                the bottom of the column whenever the block is taller than its
                contents, and in that case the margin costs nothing; where the
                column runs short — around the md breakpoint, where it is half
                of a small screen — it is the only thing keeping this line off
                the newsletter rule above it, which is why it holds at md too. */
            }
            <div
                class="mt-[max(2.494cqw,28px)] flex flex-col gap-[max(1.247cqw,16px)] pb-[max(2.494cqw,28px)]"
            >
                {
                    /* The funder's mark, set small and above the line rather
                    than beside it: it belongs with the acknowledgement group,
                    not in the row of two items the row below balances. */
                }
                <Image
                    src={scfLogo}
                    alt="SCF"
                    width={240}
                    densities={[1, 2]}
                    class="h-auto w-[clamp(84px,7.487cqw,120px)]"
                />
                <div
                    class="flex flex-col gap-2 text-[clamp(12px,1.123cqw,18px)] leading-none md:flex-row md:items-end md:justify-between"
                >
                    <p id="land-ack-line">{settings?.landLine}</p>
                {
                    /* A disclosure, not a link: the full acknowledgement is on the
                    page already and this uncovers it, the same way "Read full
                    testimonial" does. */
                }
                    <button
                        type="button"
                        data-land-open
                        aria-expanded="false"
                        aria-controls="land-ack"
                        class="hl-link shrink-0 cursor-pointer text-left"
                    >
                        <span class="hl-mark" aria-hidden="true"></span>
                        <span class="hl-label">{settings?.landLinkLabel}</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    {
        /* The full acknowledgement, stamped over the column it expands — bottom
        edge to bottom edge with the line that opens it, so it reads as that
        line growing rather than as a card arriving from somewhere else. It is
        the one block on the site printed in the rose the About bands leave
        unused. Anchored to the bottom rather than centred because the trigger
        is on the footer's last line: wherever the footer sits in the window
        when you click, the card opens where you are already looking.

        It only narrows to the column at lg. Between md and there the column is
        half of a small screen — 274px at the breakpoint — and this much copy
        set in it is a gutter, so below lg the card spans the footer instead.

        Absolute, not fixed: `main` is a container (`@container`), which makes
        it the containing block for fixed descendants too, so a fixed card
        would centre itself on the whole document, not the screen. It caps at
        the screen's height instead and scrolls inside. */
    }
    <div
        id="land-ack"
        data-land-panel
        role="dialog"
        aria-modal="false"
        aria-labelledby="land-ack-title"
        class="stamp-panel absolute inset-x-0 bottom-0 z-40 flex max-h-[86svh] flex-col gap-3 border border-b-2 bg-band-rose p-4 text-black/90 md:max-h-[92%] md:gap-[1.247cqw] md:p-[1.87cqw] lg:left-1/2"
    >
        <div
            class={`flex shrink-0 items-baseline justify-between gap-4 border-b pb-[0.6em] ${eyebrow} w-full`}
        >
            <span id="land-ack-title">{settings?.landTitle}</span>
            <button type="button" data-land-close class="shrink-0 cursor-pointer hover:text-pink">
                {ui?.close}
            </button>
        </div>
        {
            /* Two long paragraphs against a card that can only be as tall as the
            screen, so the body scrolls and the heading rule holds the top. */
        }
        <div class="min-h-0 flex-1 overflow-y-auto">
            <div class="flex flex-col gap-[0.9em] text-[clamp(13px,1.372cqw,22px)] leading-[1.2]">
                <RichText value={settings?.landBody} locale={locale} />
            </div>
        </div>
    </div>
</footer>
