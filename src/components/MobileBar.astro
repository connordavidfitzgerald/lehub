---
// Mobile sticky top bar (Figma: 393 x 64) + full-screen menu overlay.
import { LOCALE_CODE, barePath, localize, swapLocale, OTHER_LOCALE } from "../lib/i18n.js";

interface Props {
    nav: any[];
    settings: any;
    ui: any;
    locale: string;
}
const { nav = [], settings, ui, locale } = Astro.props;
const path = barePath(Astro.url.pathname);
const other = OTHER_LOCALE[locale];

// The menu is a flat list: there is no sidebar column to indent into here, so
// a group stands aside for the pages it holds — resources becomes reports and
// wiki, at the top level, each keeping the colour the group carries.
const items = nav.flatMap((item) =>
    item.children
        ? item.children.map((child) => ({ ...child, highlight: item.highlight }))
        : [item],
);
---

<!-- Named for the same reason as the sidebar: the bar is furniture, not page,
     so it sits out the transition. -->
<header
    style="view-transition-name: masthead"
    class="md:hidden sticky top-0 z-50 flex h-16 items-center justify-between border-b bg-shell px-4"
>
    <a href={localize("/", locale)} class="font-mark text-[38px] leading-none tracking-[-0.02em]"
        >Le HUB</a
    >
    <div class="flex items-center gap-3">
        {/* The switch sits outside the menu, not in it: changing language is
            not a destination, and someone who wants the other language wants it
            without opening a menu first. */}
        <a
            href={swapLocale(Astro.url.pathname, other)}
            hreflang={other}
            lang={other}
            class="font-sans text-[15px] leading-none underline underline-offset-2 decoration-1"
            >{LOCALE_CODE[other]}</a
        >
        <button
            type="button"
            data-menu-toggle
            aria-expanded="false"
            aria-controls="mobile-menu"
            class="bg-pink px-4 py-1.5 font-sans text-[15px] leading-none"
        >
            <span data-menu-label data-open={ui?.menu} data-close={ui?.menuClose}>{ui?.menu}</span>
        </button>
    </div>
</header>

<div
    id="mobile-menu"
    data-menu-panel
    hidden
    class="md:hidden fixed inset-0 top-16 z-40 flex flex-col justify-between bg-shell px-4 pb-6 pt-8"
>
    <nav class="flex flex-col gap-1 font-display text-[52px] uppercase leading-[0.88]">
        {
            items.map((item, i) => (
                <a
                    href={item.external ? item.href : localize(item.href, locale)}
                    target={item.external ? "_blank" : undefined}
                    rel={item.external ? "noopener" : undefined}
                    data-menu-item
                    style={`--i:${i};--hl:${item.highlight}`}
                    class:list={["hl-link", path === item.href && "is-current"]}
                >
                    <span class="hl-mark" aria-hidden="true" />
                    <span class="hl-label">{item.label}</span>
                </a>
            ))
        }
    </nav>
    <div class="flex flex-col text-[13px] leading-[1.3]">
        <span class="h-px w-full bg-black"></span>
        <p class="py-2.5 whitespace-pre-line">
            {settings?.nextCourse}<br />
            <span
                >{ui?.signUp}{" "}<button
                    type="button"
                    data-newsletter-open
                    class="cursor-pointer underline underline-offset-2 decoration-1"
                    >{ui?.signUpHere}</button
                ></span
            >
        </p>
        <span class="h-px w-full bg-black"></span>
        <form class="flex flex-col gap-1.5 pt-2.5" data-newsletter-open>
            <label for="nl-mobile">{settings?.newsletterLabel}</label>
            <input
                id="nl-mobile"
                type="email"
                placeholder={ui?.emailPlaceholder}
                data-newsletter-field
                class="w-full bg-transparent pb-2.5 outline-none focus:text-black"
            />
        </form>
        <span class="h-px w-full bg-black"></span>
    </div>
</div>
