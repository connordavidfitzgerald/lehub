---
// Desktop-only fixed sidebar. Figma: 318 / 1920 = 16.56% of viewport width,
// 20px padding all round, so the content box is 278px at the 1920 artboard.
import { nav, currentPath, isCurrent } from "../data/nav.js";
import { ACTION, TRAP } from "../data/newsletter.js";
import Arrow from "./Arrow.astro";
const path = currentPath(Astro.url);

// 14px at the 1920 artboard — the whole footer block of the sidebar is set at
// one size, with 10px (0.52vw) gaps and hairline rules between the groups.
const fine = "text-[clamp(14px,0.75vw,18px)] leading-none tracking-[-0.01em]";
---

<aside
    class="@container hidden md:flex fixed top-0 left-0 z-50 h-screen w-[max(16.56vw,220px)] flex-col justify-between border-r bg-shell p-[max(1.04vw,14px)]"
>
    <div class="flex flex-col gap-[max(1.04vw,14px)]">
        <!-- 29.17cqw is measured, not eyeballed: "Le HUB" is 3.428em wide in Review
             Black at -0.04em tracking, so it spans the sidebar's content box exactly. -->
        <a href="/" class="font-mark leading-[0.9] tracking-[-0.04em] text-[29.17cqw]">Le HUB</a>
        <nav
            class="flex flex-col text-[clamp(22px,1.25vw,28px)] leading-none tracking-[-0.01em] lowercase"
        >
            {
                nav.map((item) =>
                    item.children ? (
                        // Open on load when you are already inside the group,
                        // so the page you are on is never hidden behind a
                        // collapsed parent.
                        <div class="flex flex-col">
                            <button
                                type="button"
                                data-nav-toggle
                                aria-expanded={String(isCurrent(item, path))}
                                aria-controls={`nav-desktop-${item.label}`}
                                style={`--hl:${item.hl}`}
                                class:list={[
                                    "hl-link w-fit cursor-pointer text-left lowercase",
                                    isCurrent(item, path) && "is-current",
                                ]}
                            >
                                <span class="hl-mark" aria-hidden="true" />
                                <span class="hl-label">{item.label}</span>
                            </button>
                            <div
                                id={`nav-desktop-${item.label}`}
                                class="disclosure"
                                data-open={isCurrent(item, path) ? "" : undefined}
                            >
                                <div>
                                    <div class="flex flex-col gap-[0.15em] pt-[0.15em] pl-[0.8em]">
                                        {item.children.map((child) => (
                                            <a
                                                href={child.href}
                                                style={`--hl:${item.hl}`}
                                                class:list={[
                                                    "hl-link w-fit",
                                                    path === child.href && "is-current",
                                                ]}
                                            >
                                                <span class="hl-mark" aria-hidden="true" />
                                                <span class="hl-label">{child.label}</span>
                                            </a>
                                        ))}
                                    </div>
                                </div>
                            </div>
                        </div>
                    ) : (
                        <a
                            href={item.href}
                            style={`--hl:${item.hl}`}
                            class:list={["hl-link w-fit", path === item.href && "is-current"]}
                        >
                            <span class="hl-mark" aria-hidden="true" />
                            <span class="hl-label">{item.label}</span>
                        </a>
                    ),
                )
            }
        </nav>
    </div>

    <div class={`flex flex-col gap-[max(0.52vw,7px)] ${fine}`}>
        <span class="h-px w-full bg-black"></span>
        <p class="leading-none">
            Next course:<br />Groundswell (May 18th)<br /><br />
            {/* A button, not a link: it opens the sign-up card rather than
                navigating, and it was pointing at `#` — nowhere — before. */}
            <span class="inline-block"
                >Sign up <button
                    type="button"
                    data-newsletter-open
                    class="cursor-pointer underline underline-offset-2 decoration-1 hover:text-pink"
                    >here</button
                ></span
            >
        </p>
        <span class="h-px w-full bg-black"></span>
        {/* Posts to the list directly, like the footer's field — the card is
            what "here" above opens, and sending this one there too would just
            ask for the address twice. */}
        <form
            action={ACTION}
            method="post"
            target="_blank"
            class="flex flex-col gap-[max(0.52vw,7px)]"
        >
            <label for="nl-desktop">Subscribe to our newsletter:</label>
            <div class="flex w-full items-center gap-2">
                <input
                    id="nl-desktop"
                    type="email"
                    name="EMAIL"
                    required
                    autocomplete="email"
                    placeholder="Email"
                    class="min-w-0 flex-1 bg-transparent leading-none outline-none focus:text-black"
                />
                {/* Bare, not the footer's pink square: at this size a filled
                    block would be a button stuck to the side of a hairline
                    rule. It is the mark alone, taking the row's own colour. */}
                <button
                    type="submit"
                    aria-label="Subscribe"
                    class="shrink-0 cursor-pointer leading-none hover:text-pink"
                >
                    <Arrow class="h-[1em] w-[1em]" />
                </button>
            </div>
            {/* Off-screen rather than hidden: a bot fills what it can read, and
                `display: none` is the one thing they know to skip. */}
            <div class="absolute left-[-5000px]" aria-hidden="true">
                <input type="text" name={TRAP} tabindex="-1" value="" />
            </div>
        </form>
        <span class="h-px w-full bg-black"></span>
    </div>
</aside>
