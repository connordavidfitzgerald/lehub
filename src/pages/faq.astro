---
import Layout from "../layouts/Layout.astro";
import Img from "../components/Img.astro";
import SectionBand from "../components/SectionBand.astro";
import RichText from "../components/RichText.astro";
import { social } from "../data/social.js";

// Only the first answer exists in the Figma file; the rest are drafted to
// match its voice and are marked for client review.
//
// Answers are lists of segments rather than plain strings so the things they
// name can be reached from where they are named — see RichText. Every answer is
// a list, including the ones with nothing to link, so they all have one shape.
const faqs = [
    {
        q: "Are Le Hub's programs free?",
        a: [
            "Yes. Every program we run is free, because organizers should have good training and support whatever their income, where they live, or what their organization can afford.",
        ],
        draft: false,
    },
    {
        q: "Who can take part?",
        a: [
            "Anyone organizing at the grassroots across so-called Canada and Québec — whether you are part of an established group, a new collective, or organizing on your own. ",
            { text: "Our programs", href: "/offerings" },
            " run in English and in French, and many participants are young organizers, though we work with organizers of all ages.",
        ],
        draft: true,
    },
    {
        q: "Can I sign up for coaching if I've never been to a Le Hub training?",
        a: [
            "You can. ",
            { text: "Compass", href: "/offerings#compass" },
            " is open to any organizer who wants ongoing, tailored support — attending a training first is welcome but never required.",
        ],
        draft: true,
    },
    {
        q: "Can I sign up for coaching if I'm not running a campaign?",
        a: [
            "Yes. Coaches can help you think through where to start: choosing an issue, building a group, or working out what a winnable campaign might look like before you launch one.",
        ],
        draft: true,
    },
    {
        q: "My organization wants to collaborate with Le Hub. How do we get in touch?",
        a: [
            "Write to ",
            { text: "contact@lehub.ca", href: "mailto:contact@lehub.ca" },
            " and tell us about your group and what you are working on. We build ",
            { text: "Catalyst", href: "/offerings#catalyst" },
            " camps with local grassroots groups, and we are always glad to hear from organizations doing the work.",
        ],
        draft: true,
    },
    {
        q: "How do I hear about new trainings and events?",
        a: [
            "Sign up for ",
            { text: "our newsletter", newsletter: true },
            ", or follow us on ",
            { text: "Instagram", href: social.instagram },
            " and ",
            { text: "Facebook", href: social.facebook },
            ". ",
            { text: "Groundswell", href: "/offerings#groundswell" },
            " runs twice a year, in spring and fall, and we announce registration there first.",
        ],
        draft: true,
    },
];
---

<Layout title="Le Hub — FAQ">
    <section class="h-[52svh] min-h-[320px] w-full md:h-[78vh] md:min-h-[420px]">
        <Img name="aboutus.png" alt="The Le Hub studio during a work session" loading="eager" />
    </section>

    <div class="w-full bg-purple">
        <SectionBand title="FAQ" fit bg="bg-purple" size="text-[64.31cqw]" />

        <div class="flex flex-col">
            {
                faqs.map((item) => (
                    <div
                        data-faq-item
                        data-draft={item.draft ? "true" : undefined}
                        {/* The purple is the section's ground, not the item's —
                            an open item lays paper over it so the answer reads
                            on the same stock as the rest of the site. Keyed off
                            the trigger's own aria-expanded via `has-`, so the
                            open state stays in one place and the JS keeps
                            managing exactly what it already did. */}
                        class="border not-first:border-t has-[[data-faq-trigger][aria-expanded='true']]:bg-paper"
                    >
                        <button
                            type="button"
                            data-faq-trigger
                            aria-expanded="false"
                            class="group flex w-full cursor-pointer items-start justify-between gap-4 px-[1%] py-[0.4%] text-left hover:bg-black/10"
                        >
                            <h2 class="text-[clamp(36px,5.926cqw,95px)] leading-[0.9] text-black/90">
                                {item.q}
                            </h2>
                            <span class="mt-2 shrink-0 font-sans text-[clamp(18px,2.246cqw,36px)] leading-none group-aria-expanded:rotate-45">
                                +
                            </span>
                        </button>
                        <div data-faq-answer>
                            {/* Set as the offerings accordion sets its blurb —
                                180/1603 is the bar, 38/1603 = 2.32cqw the copy
                                under it — so the two accordions on the site
                                answer in the same voice. */}
                            <p class="max-w-[72ch] px-[1%] pb-[1.2%] pt-1 font-sans text-[clamp(14px,2.32cqw,38px)] leading-none text-black/90">
                                <RichText parts={item.a} />
                            </p>
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</Layout>
