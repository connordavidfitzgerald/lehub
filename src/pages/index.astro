---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import hero from "../assets/images/hero-home.jpg";
import lehub from "../assets/images/lehub-home.png";
import wiki from "../assets/images/wiki.png";
import reports from "../assets/images/reports.png";
import PillarBars from "../components/PillarBars.astro";
import SectionBand from "../components/SectionBand.astro";
import Testimonials from "../components/Testimonials.astro";

// The blue plate behind WIKI / REPORTS. 160/1603 = 9.98cqw, set solid with the
// 9px optical drop under the baseline that the band carries in Figma.
const plate =
    "font-display font-extrabold uppercase leading-[0.8] pb-[0.056em] bg-blue text-black/70 text-[clamp(48px,9.98cqw,160px)]";
---

<Layout title="Le Hub — Learn to organize, build movements">
    <!-- 1 · HERO -------------------------------------------------------- -->
    <section
        class="relative flex h-[100svh] w-full items-center justify-center md:h-screen md:min-h-[560px]"
    >
        <Image
            src={hero}
            alt="Organizers making banners together"
            loading="eager"
            class="absolute inset-0 h-full w-full object-cover"
        />
        <!-- The comma hangs below the band, and is meant to. With leading at
             0.71em the baseline sits 0.04em below the content box and Review
             Condensed's comma drops another 0.135em under that, so at the
             Figma 0.05em padding it clears the pink by 0.125em. Covering it
             costs more than it is worth either way: growing the padding makes
             this band taller than "build movements.", and hanging the block
             lower leaves a lip at each end where this line runs wider. The
             band follows the baseline, the comma hangs off it. -->

        <!-- 9.98cqw is measured, not eyeballed: at 160px on the 1603 artboard
             "LEARN TO ORGANIZE," is 8.04em wide, so the longer of the two bands
             sits just inside the column with the pair optically centred. -->
        <h1
            class="relative z-10 flex w-full flex-col items-center text-[clamp(34px,9.98cqw,160px)] leading-[0.71] text-nowrap text-black/80"
        >
            <span
                class="block w-fit px-[0.031em] pt-[0.019em] pb-[0.05em]"
                data-sticker
                data-sticker-band>Learn to organize,</span
            >
            <span
                class="block w-fit px-[0.031em] pt-[0.019em] pb-[0.05em]"
                data-sticker
                data-sticker-band
                style="--sticker-stagger:1;--sticker-offset:12">build movements.</span
            >
        </h1>
    </section>

    <!-- 2 · ABOUT ------------------------------------------------------- -->
    <section class="w-full border-t bg-paper">
        <SectionBand title="About" fit bg="bg-lime" text="text-lime-ink" size="text-[36.9cqw]" />
        <div class="flex w-full flex-col md:min-h-[67.374cqw] md:flex-row">
            <div class="aspect-[3/4] w-full md:aspect-auto md:h-auto md:w-1/2 md:border-r">
                <Image
                    src={lehub}
                    alt="Le Hub organizers at work"
                    class="h-full w-full object-cover"
                />
            </div>
            <!-- The paragraph stays optically centred in the row; "Learn more"
                 holds the bottom edge on the same 2.43cqw margin the column is
                 inset by. The row runs 1603/1080 rather than the artboard's
                 1603/991 so it matches the TESTIMONIALS block and the footer. -->
            <div class="relative flex w-full flex-col justify-center p-6 md:w-1/2 md:p-[2.43cqw]">
                <div
                    class="flex flex-col gap-[1em] text-[clamp(18px,2.246cqw,36px)] leading-none tracking-[-0.01em]"
                >
                    <p>
                        Le HUB is a bilingual training centre for organizers and grassroots groups
                        across so-called Canada and Québec.
                    </p>
                    <p>
                        We help communities develop the skills, strategic capacity, and solidarity
                        required to win campaigns that shift power and improve people’s lives.
                    </p>
                </div>
                <a
                    href="/about"
                    class="mt-10 w-fit text-[clamp(14px,1.497cqw,24px)] leading-none tracking-[-0.02em] hover:text-pink md:absolute md:bottom-[2.43cqw] md:left-[2.43cqw] md:mt-0"
                    >Learn more →</a
                >
            </div>
        </div>
    </section>

    <!-- 3 · OFFERINGS --------------------------------------------------- -->
    <section class="w-full border-t bg-paper">
        <SectionBand
            title="Offerings"
            fit
            bg="bg-gold"
            text="text-black/80"
            size="text-[23.15cqw]"
        />
        <PillarBars />
    </section>

    <!-- 4 · TESTIMONIALS ------------------------------------------------ -->
    <Testimonials />

    <!-- 5 · RESOURCES --------------------------------------------------- -->
    <!-- Band and tiles are one section, like ABOUT and OFFERINGS above: left on
         its own the band would draw a rule under itself and the tiles would
         draw one over themselves, in the same place. -->
    <section class="w-full border-t bg-paper">
        <SectionBand
            title="Resources"
            fit
            bg="bg-blue"
            text="text-black/80"
            size="text-[21.23cqw]"
        />
        <div class="flex w-full flex-col md:aspect-[1603/1080] md:flex-row">
            <a
                href="#"
                class="group relative flex w-full items-center justify-center py-16 md:w-1/2 md:border-r md:py-0"
                data-resource
            >
                <Image src={wiki} alt="" class="w-[85.9%] object-contain" data-resource-art />
                <span class={`absolute ${plate}`}>Wiki</span>
            </a>
            <a
                href="/reports"
                class="group relative flex w-full items-center justify-center overflow-hidden py-16 md:w-1/2 md:py-0"
                data-resource
                style="--tilt:1.6deg"
            >
                <Image
                    src={reports}
                    alt=""
                    class="w-[90%] max-w-none object-contain md:-mt-[2.3%]"
                    data-resource-art
                />
                <span class={`absolute ${plate}`}>Reports</span>
            </a>
        </div>
    </section>
</Layout>
